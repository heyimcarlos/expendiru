{
  "name": "expendiru",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "prepare": "node scripts/ensure-spend-payload.mjs",
    "sync:spend": "node scripts/sync-spend-feed.mjs",
    "check:spend": "node --experimental-strip-types scripts/check-spend-feed.ts",
    "typecheck": "node scripts/ensure-spend-payload.mjs && tsc --build",
    "test": "node scripts/ensure-spend-payload.mjs && node --experimental-strip-types scripts/check-spend-feed.ts && pnpm --recursive test",
    "lint": "oxlint alchemy.run.ts stacks && pnpm --recursive lint"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@expendiru/backend": "workspace:*",
    "@expendiru/frontend": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "oxlint": "1.89.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
